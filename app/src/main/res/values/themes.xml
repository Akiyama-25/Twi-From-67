<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Material 3 Expressive Theme -->
    <style name="Theme.TwiFrom67" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status & Navigation Bar Configuration for Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Material 3 Expressive Shape Styles -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.TwiFrom67.ExtraLarge</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.TwiFrom67.Large</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.TwiFrom67.Medium</item>
    </style>

    <style name="ShapeAppearance.TwiFrom67.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.TwiFrom67.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.TwiFrom67.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.TwiFrom67.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Expressive Card Style -->
    <style name="Widget.TwiFrom67.Card" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TwiFrom67.Large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Expressive Button Style -->
    <style name="Widget.TwiFrom67.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TwiFrom67.Full</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Expressive Filter Chip Style -->
    <style name="Widget.TwiFrom67.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TwiFrom67.Full</item>
        <item name="chipCornerRadius">18dp</item>
    </style>
</resources>